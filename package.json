{
  "name": "dwiddle",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "DWIDDLE_TARGET=desktop vite build",
    "desktop": "DWIDDLE_TARGET=desktop electron .",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:all": "npm run build:desktop && electron-builder --mac --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "vite": "^8.1.1"
  },
  "main": "electron/main.cjs",
  "description": "Turn your notes into questions, and sit full length practice papers.",
  "author": {
    "name": "Dwiddle"
  },
  "build": {
    "appId": "app.dwiddle.desktop",
    "productName": "Dwiddle",
    "copyright": "Dwiddle",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Dwiddle",
            "CFBundleURLSchemes": [
              "dwiddle"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "Dwiddle",
      "artifactName": "Dwiddle-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Dwiddle-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Dwiddle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "protocols": [
      {
        "name": "Dwiddle",
        "schemes": [
          "dwiddle"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pachdono",
        "repo": "dwiddle-releases",
        "releaseType": "release"
      }
    ],
    "afterPack": "./electron/afterPack.cjs"
  }
}