{
  "name": "dwiddle",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "DWIDDLE_TARGET=desktop vite build",
    "desktop": "DWIDDLE_TARGET=desktop electron .",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:all": "npm run build:desktop && electron-builder --mac --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.4",
    "vite": "^8.1.1"
  },
  "main": "electron/main.cjs",
  "description": "Turn your notes into questions, and sit full length practice papers.",
  "author": {
    "name": "Dwiddle"
  },
  "build": {
    "appId": "app.dwiddle.desktop",
    "productName": "Dwiddle",
    "copyright": "Dwiddle",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Dwiddle",
            "CFBundleURLSchemes": [
              "dwiddle"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "Dwiddle",
      "artifactName": "Dwiddle-${version}-${arch}.dmg",
      "format": "ULFO",
      "background": "build/dmg-background.tiff",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 620,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 196,
          "type": "file"
        },
        {
          "x": 450,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Dwiddle-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dwiddle",
      "uninstallDisplayName": "Dwiddle",
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "protocols": [
      {
        "name": "Dwiddle",
        "schemes": [
          "dwiddle"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pachdono",
        "repo": "dwiddle-releases",
        "releaseType": "release"
      }
    ],
    "afterPack": "./electron/afterPack.cjs",
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "en-GB",
      "en_GB"
    ],
    "nsisWeb": {
      "artifactName": "Dwiddle-Setup-${version}.${ext}"
    }
  }
}
