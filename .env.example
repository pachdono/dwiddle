# Copy to .env.local for local development. Never commit the real values.
#
# Server only. Read by the functions in /api, never sent to the browser.
#
# Any one of these is enough. If several are set they are used in this order:
# Groq, then OpenRouter, then NVIDIA.
#
# Groq: free, and by far the fastest. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: the widest catalogue, with free models available.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional fallback, used only when there is no OpenRouter key. Free at
# https://build.nvidia.com, but an account is limited to a couple of models
# and they are frequently overloaded.
NVIDIA_API_KEY=

# Both optional, and usually best left blank. If unset, the server asks the
# provider which models the key can use and works down a preference list until
# one answers. Set one only to pin a specific model, using an id exactly as
# shown by /api/models.
# Optional. Set a long random string to reach /api/models and the debug view,
# which report on the account and spend quota when probing. Without it both
# return 404 to everyone.
ADMIN_TOKEN=

GROQ_MODEL=
OPENROUTER_MODEL=
NVIDIA_MODEL=

# Client side, and safe to expose. The VITE_ prefix ships them to the browser
# deliberately: they identify the Supabase project but grant no access on their
# own. Row level security in supabase/schema.sql is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
